# ── TrackSphere environment configuration ─────────────────────────────
# Copy to .env and adjust. All values have safe local defaults except DATABASE_URL.

# Runtime: local | development | production
TRACKSPHERE_ENV=local
# Region label attested in /health, /statusz and the evidence pack (us | eu)
TRACKSPHERE_REGION=us

# HTTP API
TRACKSPHERE_HTTP_ADDR=:8080
# Comma separated list of allowed browser origins (CORS, dev only)
TRACKSPHERE_CORS_ORIGINS=http://localhost:5173

# Database (PostgreSQL 14+).
# App runtime role — MUST NOT be superuser or table owner, otherwise
# FORCE row-level security silently does not apply (see 000004_app_role.sql).
TRACKSPHERE_DATABASE_URL=postgres://tracksphere_app:tracksphere_app@localhost:5432/tracksphere?sslmode=disable
# Pool size (default 10). One LISTEN conn per queue poller lives here too —
# raise with worker concurrency, keep below Postgres max_connections.
TRACKSPHERE_DB_MAX_CONNS=10
# Owner/admin role used only by migrations (create tables, grant privileges).
# Defaults to TRACKSPHERE_DATABASE_URL when empty (acceptable for quick local
# experiments, NOT for verifying RLS).
TRACKSPHERE_MIGRATIONS_URL=postgres://tracksphere:tracksphere@localhost:5432/tracksphere?sslmode=disable

# Run embedded migrations automatically on API/worker startup (1 = yes, 0 = no).
TRACKSPHERE_AUTO_MIGRATE=1

# Sessions & crypto
# 32-byte key, base64 or hex encoded. Used to encrypt TOTP secrets at rest.
# Generate: go run ./cmd/keygen   (or: openssl rand -base64 32)
TRACKSPHERE_SECRET_KEY=local-dev-secret-key-change-me-000000000000000000
# Session lifetime in hours
TRACKSPHERE_SESSION_TTL_HOURS=168

# Shared secret used to verify inbound carrier webhooks (HMAC-SHA256, hex).
# Signature header: X-TrackSphere-Signature: sha256=<hex>
TRACKSPHERE_CARRIER_WEBHOOK_SECRET=dev-carrier-webhook-secret
# Optional per-carrier overrides: "maersk:secret1,dhl:secret2".
# Falls back to TRACKSPHERE_CARRIER_WEBHOOK_SECRET when a carrier is absent.
# Rotate per carrier without breaking the others.
TRACKSPHERE_CARRIER_WEBHOOK_SECRETS=

# Worker
TRACKSPHERE_WORKER_CONCURRENCY=4
TRACKSPHERE_WORKER_POLL_INTERVAL_MS=500

# P2 outbound providers (anything unset falls back to the log provider —
# staging works with zero secrets; production degrades loudly, never silently)
# Default sender: log|print|webhook (requires TRACKSPHERE_NOTIFY_WEBHOOK_URL)
TRACKSPHERE_NOTIFY_DEFAULT=log
# TRACKSPHERE_NOTIFY_WEBHOOK_URL=https://example.com/notify
# Email via SMTP (STARTTLS): SMTP_HOST, SMTP_PORT=587, SMTP_USER, SMTP_PASS, SMTP_FROM
# SMS/WhatsApp via Twilio: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_FROM

# P2 Stripe billing (unset = checkout returns 501 "contact sales")
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_ENTERPRISE=price_...
# TRACKSPHERE_BILLING_SUCCESS_URL=https://app.example.com/settings?upgraded=1
# TRACKSPHERE_BILLING_CANCEL_URL=https://app.example.com/settings?canceled=1

# P2 document storage root (volume in production)
TRACKSPHERE_STORAGE_DIR=./var/docs

# P3 SSO (OIDC, stdlib-only). Unset = password+MFA only, status shows false.
# SSO_GOOGLE_CLIENT_ID= / SSO_GOOGLE_CLIENT_SECRET= / SSO_GOOGLE_REDIRECT_URL=https://app.example.com/api/v1/auth/sso/google/callback
# SSO_MICROSOFT_CLIENT_ID= / SSO_MICROSOFT_CLIENT_SECRET= / SSO_MICROSOFT_REDIRECT_URL=https://app.example.com/api/v1/auth/sso/microsoft/callback
# SSO_AUTOPROVISION=1 allows unknown verified emails to found a tenant (default 0 = login-only)

# Logging: debug | info | warn | error
TRACKSPHERE_LOG_LEVEL=info
