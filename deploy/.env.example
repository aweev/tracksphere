# Copy to deploy/.env and fill in real secrets before `docker compose up`.
# Generate secrets with:  go run ./cmd/keygen

# Postgres owner (migrations) credentials
POSTGRES_USER=tracksphere
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=tracksphere

# Application runtime role password (must match 000004_app_role.sql's role
# name; the role itself is created by that migration).
APP_DB_PASSWORD=change-me-app-password

# API session/TOTP encryption key (32 bytes, base64 or any strong passphrase)
TRACKSPHERE_SECRET_KEY=change-me-generate-with-keygen

# Shared HMAC secret for inbound carrier webhooks
TRACKSPHERE_CARRIER_WEBHOOK_SECRET=change-me-webhook-secret

TRACKSPHERE_ENV=production
TRACKSPHERE_LOG_LEVEL=info
TRACKSPHERE_SESSION_TTL_HOURS=168
TRACKSPHERE_WORKER_CONCURRENCY=4

# Image label stamped into /api/v1/health + /metrics (git SHA recommended)
APP_VERSION=dev

# Optional per-carrier webhook secrets ("maersk:s1,dhl:s2"); falls back to
# TRACKSPHERE_CARRIER_WEBHOOK_SECRET when a carrier is absent.
TRACKSPHERE_CARRIER_WEBHOOK_SECRETS=

# DB pool size (default 10)
TRACKSPHERE_DB_MAX_CONNS=10

# P2 outbound providers (unset = log provider; staging-safe)
TRACKSPHERE_NOTIFY_DEFAULT=log
# SMTP_HOST= / SMTP_PORT=587 / SMTP_USER= / SMTP_PASS= / SMTP_FROM=
# TWILIO_ACCOUNT_SID= / TWILIO_AUTH_TOKEN= / TWILIO_FROM=
# TRACKSPHERE_NOTIFY_WEBHOOK_URL=

# P2 Stripe (unset = checkout 501 "contact sales")
# STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET= / STRIPE_PRICE_GROWTH= / STRIPE_PRICE_ENTERPRISE=

# P2 document storage (mount a volume here in production)
TRACKSPHERE_STORAGE_DIR=/app/var/docs

# Region attested at runtime (us | eu — see docs/REGIONS.md)
TRACKSPHERE_REGION=us

# P3 SSO (unset = password+MFA only)
# SSO_GOOGLE_CLIENT_ID= / SSO_GOOGLE_CLIENT_SECRET= / SSO_GOOGLE_REDIRECT_URL=
# SSO_MICROSOFT_CLIENT_ID= / SSO_MICROSOFT_CLIENT_SECRET= / SSO_MICROSOFT_REDIRECT_URL=
# SSO_AUTOPROVISION=0

# Optional: only needed if the browser calls the API from another origin.
TRACKSPHERE_CORS_ORIGINS=

# Host port for the web tier
WEB_PORT=3000