# Copy to deploy/.env and fill in real secrets before `docker compose up`.
# Generate secrets with:  go run ./cmd/keygen

# Postgres owner (migrations) credentials
POSTGRES_USER=tracksphere
POSTGRES_PASSWORD=change-me-owner-password
POSTGRES_DB=tracksphere

# Application runtime role password (must match 000004_app_role.sql's role
# name; the role itself is created by that migration).
APP_DB_PASSWORD=change-me-app-password

# API session/TOTP encryption key (32 bytes, base64 or any strong passphrase)
TRACKSPHERE_SECRET_KEY=change-me-generate-with-keygen

# Shared HMAC secret for inbound carrier webhooks
TRACKSPHERE_CARRIER_WEBHOOK_SECRET=change-me-webhook-secret

TRACKSPHERE_ENV=production
TRACKSPHERE_LOG_LEVEL=info
TRACKSPHERE_SESSION_TTL_HOURS=168
TRACKSPHERE_WORKER_CONCURRENCY=4

# Optional: only needed if the browser calls the API from another origin.
TRACKSPHERE_CORS_ORIGINS=

# Host port for the web tier
WEB_PORT=3000